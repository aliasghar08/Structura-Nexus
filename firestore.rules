rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: authenticated users can access their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Project models: users have full CRUD access to their own structural projects
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared public structural library & benchmarks
    match /library/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
